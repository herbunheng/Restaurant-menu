{
  "name": "restaurant-menu",
  "appName": "Restaurant Menu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./drizzle/seed.sql",
    "db:seed:prod": "wrangler d1 execute DB --remote --file=./drizzle/seed.sql",
    "deploy": "nuxt build && wrangler pages deploy .output/public --project-name=restaurant-menu"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.1",
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.90",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "1.3.1",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/robots": "6.1.3",
    "@nuxtjs/seo": "5.3.3",
    "@scalar/hono-api-reference": "^0.5.176",
    "@takumi-rs/core": "^2.4.0",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.12.31",
    "hono-rate-limiter": "^0.5.4",
    "leaflet": "^1.9.4",
    "nuxt": "^4.4.8",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.16.0",
    "@types/leaflet": "^1.9.22",
    "drizzle-kit": "^0.30.5",
    "eslint": "^10.7.0",
    "nuxi": "^3.27.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.110.0"
  }
}
